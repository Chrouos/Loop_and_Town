{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/event-graph.schema.json",
  "title": "Loop and Town Event Graph",
  "type": "object",
  "required": ["id", "title", "time", "variants"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "time": {
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
    },
    "location": {"type": "string"},
    "conditions": {"type": "object"},
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "when", "effects"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "priority": {"type": "integer"},
          "when": {"type": "object"},
          "effects": {
            "type": "array",
            "items": {"type": "object"}
          },
          "delayed_effects": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "effects"],
              "properties": {
                "id": {"type": "string"},
                "delay_minutes": {"type": "integer", "minimum": 0},
                "execute_at": {
                  "type": "string",
                  "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                },
                "when": {"type": "object"},
                "effects": {
                  "type": "array",
                  "items": {"type": "object"}
                }
              },
              "anyOf": [
                {"required": ["delay_minutes"]},
                {"required": ["execute_at"]}
              ]
            }
          }
        },
        "additionalProperties": true
      }
    },
    "history_fields": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": true
}
