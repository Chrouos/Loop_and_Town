{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "story-dag.schema.json",
  "title": "Loop and Town Story DAG",
  "type": "object",
  "required": ["id", "title", "nodes", "edges"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    }
  },
  "$defs": {
    "visibility": {
      "type": "string",
      "enum": ["public", "author", "player-known"]
    },
    "detail": {
      "type": "object",
      "properties": {
        "before": { "type": "array", "items": { "type": "string" }, "default": [] },
        "after": { "type": "array", "items": { "type": "string" }, "default": [] },
        "reason": { "type": "string" },
        "affected_characters": { "type": "array", "items": { "type": "string" }, "default": [] },
        "delayed_effects": { "type": "array", "items": { "type": "string" }, "default": [] },
        "knowledge_changes": { "type": "array", "items": { "type": "string" }, "default": [] },
        "relationship_changes": { "type": "array", "items": { "type": "string" }, "default": [] },
        "narrative_refs": { "type": "array", "items": { "type": "string" }, "default": [] }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string", "pattern": "^N[0-9A-Za-z_]+" },
        "title": { "type": "string", "minLength": 1 },
        "time": { "type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$" },
        "actor_ids": { "type": "array", "items": { "type": "string" }, "default": [] },
        "visibility": { "$ref": "#/$defs/visibility", "default": "public" },
        "detail": { "$ref": "#/$defs/detail" }
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": ["id", "source", "target", "label"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "visibility": { "$ref": "#/$defs/visibility", "default": "public" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
